<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔒 Security Lock"
        android:textColor="@color/text_white"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="App kholne ke liye 4-digit PIN enter karein"
        android:textColor="@color/text_gray"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etPin"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@color/card_dark"
        android:gravity="center"
        android:hint="PIN (e.g. 1234)"
        android:inputType="numberPassword"
        android:maxLength="4"
        android:padding="12dp"
        android:textColor="@color/text_white"
        android:textColorHint="@color/text_gray"
        android:textSize="22sp" />

    <Button
        android:id="@+id/btnUnlock"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/primary_accent"
        android:text="Unlock"
        android:textColor="@color/bg_dark"
        android:textStyle="bold" />
</LinearLayout>
