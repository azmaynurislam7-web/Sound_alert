<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0F1D">

    <!-- Fragment Container for Tabs -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Telegram Style Floating Bottom Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_telegram_nav"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:padding="8dp">

        <!-- Tab 1: Chats / Home -->
        <LinearLayout
            android:id="@+id/navChats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="6dp">

            <TextView
                android:id="@+id/iconChats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="\uf086"
                android:textSize="20sp"
                android:textColor="#34D399"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chats"
                android:textColor="#34D399"
                android:textSize="11sp"/>
        </LinearLayout>

        <!-- Tab 2: Voice Packs -->
        <LinearLayout
            android:id="@+id/navVoices"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="6dp">

            <TextView
                android:id="@+id/iconVoices"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="\uf001"
                android:textSize="20sp"
                android:textColor="#9CA3AF"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Voices"
                android:textColor="#9CA3AF"
                android:textSize="11sp"/>
        </LinearLayout>

        <!-- Tab 3: Settings -->
        <LinearLayout
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="6dp">

            <TextView
                android:id="@+id/iconSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="\uf013"
                android:textSize="20sp"
                android:textColor="#9CA3AF"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textColor="#9CA3AF"
                android:textSize="11sp"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
