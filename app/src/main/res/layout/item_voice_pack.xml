<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="6dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardVoiceContainer"
        android:layout_width="85dp"
        android:layout_height="85dp"
        app:cardBackgroundColor="@color/card_dark"
        app:cardCornerRadius="42.5dp"
        app:cardElevation="0dp"
        app:strokeColor="#262626"
        app:strokeWidth="1dp">

        <ImageView
            android:id="@+id/imgVoiceAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:padding="18dp"
            app:tint="#00E676" />

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvVoiceName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Voice Name"
        android:textColor="@android:color/white"
        android:textSize="11sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:gravity="center" />

    <TextView
        android:id="@+id/tvVoiceStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Tap to Select"
        android:textColor="#9CA3AF"
        android:textSize="9sp"
        android:gravity="center" />

</LinearLayout>
