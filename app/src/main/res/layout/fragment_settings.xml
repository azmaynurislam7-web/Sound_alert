<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0F1D"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="API Configuration"
        android:textColor="@android:color/white"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Setup your Razorpay credentials"
        android:textColor="#9CA3AF"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etWebhookUrl"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="24dp"
        android:background="#1E293B"
        android:hint="Webhook URL"
        android:paddingHorizontal="16dp"
        android:textColor="@android:color/white"
        android:textColorHint="#64748B"
        android:textSize="15sp" />

    <EditText
        android:id="@+id/etRazorpayKey"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:background="#1E293B"
        android:hint="Razorpay Key ID"
        android:paddingHorizontal="16dp"
        android:textColor="@android:color/white"
        android:textColorHint="#64748B"
        android:textSize="15sp" />

    <EditText
        android:id="@+id/etWebhookSecret"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:background="#1E293B"
        android:hint="Webhook Secret"
        android:inputType="textPassword"
        android:paddingHorizontal="16dp"
        android:textColor="@android:color/white"
        android:textColorHint="#64748B"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btnSaveConfig"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="28dp"
        android:backgroundTint="#10B981"
        android:text="Save Configuration"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
