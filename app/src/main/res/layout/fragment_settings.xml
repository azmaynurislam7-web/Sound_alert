<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111B21"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="#E9EDEF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Account / Email Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#202C33"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACCOUNT"
                android:textColor="#00A884"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvUserEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="user@email.com"
                android:textColor="#E9EDEF"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Profile Photo Setting -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">
            <TextView android:text="Profile Photo" android:textColor="#00A884" android:textSize="14sp"/>
            <TextView android:text="Everyone can see your profile photo" android:textColor="#8696A0" android:textSize="12sp"/>
        </LinearLayout>

        <!-- Last Seen & Online Setting -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">
            <TextView android:text="Last Seen &amp; Online" android:textColor="#00A884" android:textSize="14sp"/>
            <TextView android:text="Who can see my last seen: Everyone / Nobody" android:textColor="#8696A0" android:textSize="12sp"/>
        </LinearLayout>

        <!-- Read Receipts -->
        <Switch
            android:id="@+id/switchReadReceipts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Read Receipts (Blue Ticks)"
            android:textColor="#E9EDEF" />

        <!-- Typing Indicator -->
        <Switch
            android:id="@+id/switchTyping"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Show Typing Indicator"
            android:textColor="#E9EDEF" />

        <!-- Chat Theme -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Chat Theme (Dark / Light)"
            android:textColor="#00A884"
            android:textSize="14sp" />

        <!-- Logout Button -->
        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:backgroundTint="#F15C6D"
            android:text="LOGOUT"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
