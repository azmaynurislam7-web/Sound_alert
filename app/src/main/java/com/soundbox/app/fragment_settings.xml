<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Configuration Settings"
        android:textColor="@color/text_white"
        android:textSize="22sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etWebhookUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Webhook URL"
        android:textColor="@color/text_white"
        android:textColorHint="@color/text_gray" />

    <EditText
        android:id="@+id/etRazorpayKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Razorpay Key"
        android:textColor="@color/text_white"
        android:textColorHint="@color/text_gray" />

    <EditText
        android:id="@+id/etWebhookSecret"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Webhook Secret"
        android:textColor="@color/text_white"
        android:textColorHint="@color/text_gray" />

    <Button
        android:id="@+id/btnSaveConfig"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Save Configuration" />

</LinearLayout>
